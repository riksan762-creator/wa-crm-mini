rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: baca/tulis semua data
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Tenant owner: cuma boleh akses data milik tenant-nya sendiri
    function myTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // cuma diisi manual lewat Firebase Console
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAdmin() || (request.auth != null && myTenantId() == tenantId);
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read, update: if isAdmin() ||
        (request.auth != null && resource.data.tenantId == myTenantId());
      allow create: if isAdmin() ||
        (request.auth != null && request.resource.data.tenantId == myTenantId());
      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read, create: if request.auth != null;
        allow update, delete: if isAdmin();
      }
    }
  }
}
